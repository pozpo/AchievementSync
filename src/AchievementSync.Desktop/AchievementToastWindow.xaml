<Window x:Class="AchievementSync.Desktop.AchievementToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="470" SizeToContent="Height" MinHeight="112" MaxHeight="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False" WindowStartupLocation="Manual">
    <Border x:Name="RootBorder" CornerRadius="14" Background="#F20D1016" BorderBrush="#453E63" BorderThickness="1.5"
            Padding="15,13" Margin="2" MouseLeftButtonUp="Toast_MouseLeftButtonUp">
        <Grid>
            <Border x:Name="AccentGlow" CornerRadius="13" Opacity="0.15" IsHitTestVisible="False"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="IconContainer" Width="66" Height="66" CornerRadius="12" Background="#1E2230" BorderBrush="#3A3950" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                    <Grid>
                        <Image x:Name="IconImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        <TextBlock x:Name="IconGlyph" Text="✦" Foreground="#A99CFF" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTagText" Text="ACHIEVEMENT UNLOCKED" Foreground="#A18BFF" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="AchievementTitleText" Foreground="#F6F7FC" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="44"/>
                    <TextBlock x:Name="DescriptionText" Foreground="#838CA2" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="34"/>
                    <Grid x:Name="ProgressContainer" Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="AchievementProgressBar" Height="5" Minimum="0" Maximum="100" Value="0"
                                     Background="#252B3B" Foreground="#72E0BB" BorderThickness="0"/>
                        <TextBlock x:Name="ProgressText" Grid.Column="1" Foreground="#CED4E0" FontSize="9" Margin="6,-2,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="GameNameText" Foreground="#5C677C" FontSize="9" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
