<UserControl x:Class="AchievementSync.Desktop.Controls.AchievementEnablerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="700"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Achievement Enabler" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Pick a game folder or executable, select the target emulator, and review every file operation before applying. AchievementSync progress JSON is separate from emulator catalogs and artwork." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding ActivityStatus}" FontSize="11" Foreground="{StaticResource MintBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>

        <!-- Step 1 & 2: Setup flow -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowGenerateButton, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="0,0,10,0">
                <!-- Step 1: Steam account & refresh token -->
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="STEP 1: Sign in to Steam (Refresh token)" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Save your Steam credentials safely in Windows Credential Manager. The internal generator uses this login to fetch schema and write refresh_tokens.json directly without any external tool." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SteamAccountStatus}" FontSize="11" Foreground="{StaticResource MintBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Steam Username:" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SteamUsernameBox" Text="{Binding SteamUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" Height="40" Padding="12,6" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Steam Password:" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="SteamPasswordBox" Style="{StaticResource SecretBox}" Height="40" Padding="12,6" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Save Steam Login &amp; Token" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="SaveSteamLogin_Click" Margin="0,0,8,0"/>
                                <Button Content="Clear" Style="{StaticResource QuietButton}" Padding="12,8" Click="ClearSteamLogin_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Step 2: Choose the game -->
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="STEP 2: Select the game folder, executable, and AppID" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Choose the game folder (or pick its .exe directly). ColdClient, Epic, GOG, and EA/Origin also use the Game executable field below. Click Detect to resolve executables and AppID automatically." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Game folder:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="105"/>
                            <TextBox x:Name="GamePathBox" Grid.Column="1" Style="{StaticResource SearchBox}" Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Full path to the game folder (or game executable)"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button x:Name="BrowseFolderButton" Content="Browse folder..." Style="{StaticResource QuietButton}" Padding="12,8" Click="BrowseFolder_Click" Margin="0,0,6,0"/>
                                <Button x:Name="BrowseMainExeButton" Content="Browse exe..." Style="{StaticResource QuietButton}" Padding="12,8" Click="BrowseExe_Click" ToolTip="Select the game .exe directly"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Game executable:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="105"/>
                            <ComboBox x:Name="ExecutableBox" Grid.Column="1" IsEditable="True" ItemsSource="{Binding DiscoveredExecutables}" Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Height="36" Padding="10,4" ToolTip="Target .exe used by ColdClient (ColdClientLoader.ini), Epic (Launch *.bat), GOG (UniverseLAN launcher), and EA/Origin (DLL import patching)"/>
                            <Button x:Name="BrowseExeButton" Grid.Column="2" Content="Select exe..." Style="{StaticResource QuietButton}" Padding="12,8" Click="BrowseExe_Click" Margin="8,0,0,0" ToolTip="Browse for a specific game executable (.exe)"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Game ID / AppID:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="AppIdBox" Style="{StaticResource SearchBox}" Width="220" Text="{Binding SteamAppId, UpdateSourceTrigger=PropertyChanged}" ToolTip="Steam, Ubisoft, and EA use the cross-listed Steam AppID. GOG gets its product ID from goggame-*.info; to create definitions from a Steam catalog, enter that game's Steam AppID here. Epic uses the Epic product namespace/AppId."/>
                            </StackPanel>
                            <Button x:Name="DetectButton" Grid.Column="1" Content="Detect" Style="{StaticResource QuietButton}" Padding="14,8" Click="Detect_Click" ToolTip="Auto-detect platform, executables, and AppID from the selected folder"/>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Target emulator:" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="TargetCombo" ItemsSource="{Binding TargetOptions}" SelectedValuePath="Value" SelectedValue="{Binding SelectedTarget, UpdateSourceTrigger=PropertyChanged}" TextSearch.TextPath="Label" Width="420" VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="RefreshGeneratorCheckBox" Grid.Row="5" IsChecked="True" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,6" ToolTip="Refreshes metadata/schemas/compatibility data for the selected target emulator before planning.">
                            <TextBlock Text="Refresh achievement metadata &amp; compatibility data before planning" FontSize="11" TextWrapping="Wrap"/>
                        </CheckBox>

                        <CheckBox x:Name="SteamStubHelperCheckBox" Grid.Row="6" IsChecked="False" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6" Visibility="{Binding ShowSteamStubHelperOption, Converter={StaticResource BoolToVisibility}}" ToolTip="Adds the optional SteamStub helper DLLs to _ColdClient\extra_dlls and configures the loader to inject them at startup. Leave off unless this game requires them.">
                            <TextBlock Text="Include optional SteamStub helpers (experimental; only for games that require them)" FontSize="11" TextWrapping="Wrap"/>
                        </CheckBox>

                        <Border Grid.Row="7" Background="#111721" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Detection evidence" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="EvidenceText" FontSize="11" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Step 3: Plan preview -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="STEP 3: Review the plan" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text=" — " FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding PlanBlockersCount, StringFormat='{}{0} blocker(s)'}" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0" Visibility="{Binding HasPlanBlockers, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding PlanWarningsCount, StringFormat='{}{0} warning(s)'}" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="8,0,0,0" Visibility="{Binding HasPlanWarnings, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Back to settings" Style="{StaticResource QuietButton}" Padding="12,6" Click="BackToEdit_Click"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="340">
                    <ItemsControl ItemsSource="{Binding PlanItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#111721" BorderBrush="#293345" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#292447" BorderBrush="#5045A2" BorderThickness="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding KindIcon}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Destination}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Source}" FontSize="9" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#111721" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0" Visibility="{Binding HasPlanDetails, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasPlanBlockers, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="⛔ Required before Apply" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                            <ItemsControl ItemsSource="{Binding PlanBlockers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="• "/><Run Text="{Binding Path=., Mode=OneWay}"/></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasPlanWarnings, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="⚠ Warnings" FontSize="10" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                            <ItemsControl ItemsSource="{Binding PlanWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="• "/><Run Text="{Binding Path=., Mode=OneWay}"/></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasPlanNotes, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ℹ Notes" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                            <ItemsControl ItemsSource="{Binding PlanNotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="• "/><Run Text="{Binding Path=., Mode=OneWay}"/></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Step 3: Apply / Done -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource QuietButton}" Padding="16,8" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="ApplyButton" Content="Apply plan" Style="{StaticResource PrimaryButton}" Padding="18,8" MinWidth="140" Click="Apply_Click" IsDefault="True" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanApplyPlan}"/>
                <Button x:Name="GeneratePlanButton" Content="Generate plan" Style="{StaticResource PrimaryButton}" Padding="18,8" MinWidth="140" Click="GeneratePlan_Click" Visibility="{Binding ShowGenerateButton, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
