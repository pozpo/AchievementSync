<Window x:Class="AchievementSync.Desktop.GameDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game achievements" Width="1000" Height="780" MinWidth="760" MinHeight="620"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="15" ClipToBounds="True" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Margin="0,0,0,18">
            <Grid>
                <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#282546" Offset="0"/><GradientStop Color="#192A36" Offset="1"/></LinearGradientBrush></Grid.Background>
                <Image x:Name="HeroArtwork" Stretch="UniformToFill"/>
                <Border Background="#A00B1018"/>
                <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom"><TextBlock Text="GAME ACHIEVEMENTS" FontSize="10" FontWeight="Bold" Foreground="#D7D2FF"/><TextBlock x:Name="GameTitle" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock x:Name="AppIdText" FontSize="11" Foreground="#CED4E0" Margin="0,4,0,0"/></StackPanel>
                    <Button Grid.Column="1" Content="Identify game" Click="IdentifyGame_Click" Style="{StaticResource QuietButton}" VerticalAlignment="Top" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Close" IsCancel="True" Style="{StaticResource QuietButton}" VerticalAlignment="Top"/>
                </Grid>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,8,0"><StackPanel><TextBlock Text="UNLOCKED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="UnlockedText" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="4,0,4,0"><StackPanel><TextBlock Text="LOCKED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LockedText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="8,0,0,0"><StackPanel><TextBlock Text="COMPLETION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CompletionText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Achievement list" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="CatalogNote" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Search achievement name"/></Grid>

        <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,9">
                <Button Content="All" Tag="All" Click="FilterButton_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,0" Padding="12,7"/>
                <Button Content="Unlocked" Tag="Unlocked" Click="FilterButton_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,0" Padding="12,7"/>
                <Button Content="Locked" Tag="Locked" Click="FilterButton_Click" Style="{StaticResource QuietButton}" Padding="12,7"/>
            </StackPanel>
            <ListView x:Name="AchievementList" Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate><DataTemplate>
                    <Border BorderBrush="#273141" BorderThickness="0,0,0,1" Padding="13,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="10" Background="#292447" VerticalAlignment="Top" ClipToBounds="True"><Grid><TextBlock Text="✦" Foreground="#B3A9FF" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding IconImage}" Stretch="UniformToFill"/></Grid></Border>
                            <StackPanel Grid.Column="1" Margin="10,0,12,0"><TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding IdentifierText}" FontSize="9" Foreground="#768399" Margin="0,3,0,0"/><TextBlock Text="{Binding DescriptionText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding UnlockDateText}" FontSize="10" Foreground="{StaticResource MintBrush}" Margin="0,6,0,0"/></StackPanel>
                            <Border Grid.Column="2" CornerRadius="9" Padding="9,5" Background="#202936" VerticalAlignment="Top"><TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StateBrush}"/></Border>
                        </Grid>
                    </Border>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Window>
