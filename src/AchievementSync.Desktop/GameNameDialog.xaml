<Window x:Class="AchievementSync.Desktop.GameNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit game name" Width="500" Height="250" MinWidth="440" MinHeight="230"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0"><TextBlock Text="Set a display name" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="This name is saved only on this PC. It does not change the AppID or achievement data." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        <TextBox x:Name="GameNameTextBox" Grid.Row="1" Style="{StaticResource SearchBox}" Margin="0,18,0,0" MinHeight="38" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/>
            <Button Content="Save name" IsDefault="True" Click="SaveName_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
