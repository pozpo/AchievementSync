<Window x:Class="AchievementSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AchievementSync" Icon="pack://application:,,,/Assets/AchievementSync.ico" Width="1450" Height="930" MinWidth="1100" MinHeight="720"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#1C2430" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,24,18,20">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="5,0,0,38">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#292447" BorderBrush="#5045A2" BorderThickness="1"><TextBlock Text="✦" Foreground="#B3A9FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="12,1,0,0" VerticalAlignment="Center"><TextBlock Text="ACHIEVEMENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="SYNC" FontSize="19" FontWeight="Bold"/></StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#667386" Margin="12,0,0,10"/>
                    <Button Style="{StaticResource NavigationButton}" Command="{Binding NavigationCommand}" CommandParameter="Dashboard" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="◈" FontSize="17" Width="29" Foreground="#B3A9FF"/><TextBlock Text="Overview" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButton}" Command="{Binding NavigationCommand}" CommandParameter="Games" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="17" Width="29"/><TextBlock Text="Game library" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavigationButton}" Command="{Binding NavigationCommand}" CommandParameter="Activity" Margin="0,0,0,5"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="17" Width="29"/><TextBlock Text="Sync activity" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#151B25" BorderBrush="#273141" BorderThickness="1" CornerRadius="13" Padding="14" Margin="2,0,2,16">
                        <StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Ellipse Width="7" Height="7" Fill="{StaticResource MintBrush}" VerticalAlignment="Center"/><TextBlock Text="  LOCAL LIBRARY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MintBrush}"/></StackPanel><TextBlock Text="Your files stay on this PC. Nothing is uploaded unless you choose to sync." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="17"/></StackPanel>
                    </Border>
                    <Button Style="{StaticResource NavigationButton}" Command="{Binding NavigationCommand}" CommandParameter="Settings"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="29"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>
                    <TextBlock Text="ACHIEVEMENTSYNC" FontSize="9" Foreground="#566174" Margin="12,19,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,26,36,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="YOUR ACHIEVEMENTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Welcome back" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Margin="0,0,16,0" VerticalAlignment="Center"><TextBlock Text="{Binding LastScanText}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/><TextBlock Text="{Binding ScanStatus}" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0"/></StackPanel><Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" MinWidth="132"><StackPanel Orientation="Horizontal"><TextBlock Text="⟳" FontSize="17" Margin="0,-2,8,0"/><TextBlock Text="Scan now"/></StackPanel></Button></StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="18" Padding="26,22" Margin="0,0,0,18" BorderBrush="#39325C" BorderThickness="1">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#211D37" Offset="0"/><GradientStop Color="#171D2A" Offset="0.62"/><GradientStop Color="#13242B" Offset="1"/></LinearGradientBrush></Border.Background>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" MaxWidth="620"><TextBlock Text="A clearer view of your progress" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="AchievementSync finds local profiles and brings their progress together. Your library is private until you opt in to sharing." FontSize="12" Foreground="#A6B0C0" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0"/></StackPanel><Border Grid.Column="1" Width="132" Height="106" CornerRadius="18" Background="#282447" BorderBrush="#4B4380" BorderThickness="1" Margin="24,0,4,0"><Grid><Ellipse Width="62" Height="62" Stroke="#7667F4" StrokeThickness="1" Opacity="0.45"/><Ellipse Width="42" Height="42" Stroke="#A89FFF" StrokeThickness="1" Opacity="0.65"/><TextBlock Text="✦" FontSize="29" Foreground="#C3BDFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border></Grid>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,22">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="GAMES FOUND" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding TotalGames}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Across enabled locations" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="4,0,6,0"><StackPanel><TextBlock Text="ACHIEVEMENTS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding AchievementTotalText}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Known from local profiles" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="6,0,4,0"><StackPanel><TextBlock Text="UNLOCKED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding TotalUnlocked}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}" Margin="0,7,0,0"/><TextBlock Text="Across discovered profiles" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="10,0,0,0"><StackPanel><TextBlock Text="COMPLETION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding CompletionText}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="From complete catalogs" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="#121925" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="13,10" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="RECENT UNLOCKS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding RecentUnlocksText}" FontSize="10" Foreground="#CED6E4" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid></Border>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your game library" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Profiles are combined by game ID, while every source file remains untouched." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" ToolTip="Search game title or AppID"/></Grid>
                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding GamesView}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,14,15" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="15" Padding="13">
                                                    <StackPanel>
                                                        <Border Height="145" CornerRadius="11" BorderBrush="#303951" BorderThickness="1" ClipToBounds="True"><Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#282546" Offset="0"/><GradientStop Color="#192A36" Offset="1"/></LinearGradientBrush></Grid.Background><Ellipse Width="150" Height="150" Stroke="#7667F4" StrokeThickness="1" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-35,-50"/><Ellipse Width="102" Height="102" Stroke="#A89FFF" StrokeThickness="1" Opacity="0.18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-12,-24"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/><TextBlock Text="{Binding CoverMark}" Visibility="{Binding FallbackVisibility}" FontSize="35" FontWeight="Light" Foreground="#D9D5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Background="#0D1119" Opacity="0.88" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"><StackPanel Orientation="Horizontal"><TextBlock Text="APPID" FontSize="9" FontWeight="Bold" Foreground="#AEB8C9"/><TextBlock Text="{Binding AppId}" FontSize="9" FontWeight="Bold" Foreground="#D9D5FF" Margin="5,0,0,0"/></StackPanel></Border></Grid></Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="2,13,2,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{StaticResource MintBrush}" Margin="2,7,2,0"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="2,9,2,0" Background="#2A3240" Foreground="#69D9B3" BorderThickness="0"/><TextBlock Text="{Binding AchievementCountText}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="2,8,2,0"/><TextBlock Text="{Binding RecentAchievementText}" FontSize="10" Foreground="#A6B0C0" Margin="2,9,2,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceCountText}" FontSize="9" Foreground="#68758A" Margin="2,9,2,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Border Background="#111721" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="15" Padding="28" HorizontalAlignment="Stretch" VerticalAlignment="Top" Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVisibility}}"><StackPanel HorizontalAlignment="Center" MaxWidth="500"><TextBlock Text="⌕" FontSize="34" Foreground="#8F83FF" HorizontalAlignment="Center"/><TextBlock Text="Your library is ready to discover" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="AchievementSync checks the enabled folders for known achievement profile files. Missing folders are shown in Settings and are safe to ignore." FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19" Margin="0,8,0,0"/></StackPanel></Border>
                        </Grid>
                        <TextBlock Text="{Binding IssueText}" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="{StaticResource WarningBrush}" FontSize="10" Margin="0,0,8,0"/>
                    </Grid>
                </Grid>

                <Grid Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,19"><TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Choose which locations AchievementSync scans. Missing folders remain listed as unavailable." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Achievement locations" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Recursive scanning is read-only and does not modify source files." FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource QuietButton}" Click="AddFolder_Click" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="15" Margin="0,-2,6,0"/><TextBlock Text="Add folder"/></StackPanel></Button></Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Locations}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="1,0,14,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Text="{Binding DiscoveryText}" FontSize="10" Foreground="#77849A" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0"><Ellipse Width="7" Height="7" Fill="#69758A" VerticalAlignment="Center" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#69758A"/><Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="True"><Setter Property="Fill" Value="#72E0BB"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding AvailabilityText}" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Button Content="Remove" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}" Command="{Binding DataContext.RemoveLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="9,6" FontSize="10" Margin="12,0,0,0"/></StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsActivityVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sync activity" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Connect your own public repository, review the exact JSON, then confirm each push." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Build local preview" Command="{Binding BuildExportPreviewCommand}" Style="{StaticResource QuietButton}" VerticalAlignment="Center" Padding="16,11"/></Grid>
                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" Margin="2,0,12,0"><TextBlock Text="GITHUB ACCOUNT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding GitHubAccountText}" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding GitHubStatus}" FontSize="10" Foreground="#AAB5C5" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="205"/></StackPanel>
                            <Grid Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Margin="8,0,14,4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="OWNER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding GitHubOwner, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SearchBox}" Height="34" Padding="9,6" ToolTip="Your GitHub account name"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="REPOSITORY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding GitHubRepository, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SearchBox}" Height="34" Padding="9,6" ToolTip="Your achievement-viewer fork"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="BRANCH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/><TextBox Text="{Binding GitHubBranch, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SearchBox}" Height="34" Padding="9,6" ToolTip="For example: user"/></StackPanel>
                            </Grid>
                            <CheckBox Grid.Column="1" Grid.Row="1" Content="Automatically sync after each scan (first push still needs review)" IsChecked="{Binding AutoSyncAfterScan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,2,0,0"/>
                            <UniformGrid Grid.Column="2" Grid.RowSpan="2" Columns="2" Rows="2" Width="300" VerticalAlignment="Center">
                                <Button Content="Sign in" Command="{Binding SignInToGitHubCommand}" IsEnabled="{Binding CanStartGitHubSignIn}" Style="{StaticResource QuietButton}" Padding="10,8" Margin="3" ToolTip="GitHub Device Flow; token stored in Windows Credential Manager"/>
                                <Button Content="Disconnect" Command="{Binding DisconnectGitHubCommand}" Visibility="{Binding IsGitHubSignedIn, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource QuietButton}" Padding="10,8" Margin="3"/>
                                <Button Content="Verify &amp; preview" Command="{Binding BuildGitHubPreviewCommand}" IsEnabled="{Binding CanBuildGitHubPreview}" Style="{StaticResource QuietButton}" Padding="10,8" Margin="3"/>
                                <Button Content="Push reviewed files" Command="{Binding PushGitHubPreviewCommand}" IsEnabled="{Binding CanPushGitHubPreview}" Style="{StaticResource PrimaryButton}" Padding="10,8" Margin="3"/>
                            </UniformGrid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="13" Padding="14" Margin="0,0,12,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="FILES IN PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,10"/><ListBox ItemsSource="{Binding ExportFiles}" SelectedItem="{Binding SelectedExport, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="#111721" BorderBrush="#293345" BorderThickness="1" CornerRadius="9" Padding="11"><StackPanel><TextBlock Text="{Binding RelativePath}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
                        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#151D27" BorderBrush="#293345" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10"><TextBlock Text="{Binding PreviewStatus}" FontSize="11" Foreground="{StaticResource MintBrush}" TextWrapping="Wrap"/></Border><Border Grid.Row="1" Background="#10151D" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="12"><Grid><TextBox Text="{Binding SelectedExport.Json, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#D6DFEB" FontFamily="Consolas" FontSize="12" ToolTip="Exact JSON for the selected AppID file"/><TextBlock Text="Select a file to inspect its JSON. Build preview does not upload or write any files." TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" Visibility="{Binding EmptyExportMessageVisibility}"/></Grid></Border></Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
