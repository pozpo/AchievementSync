<Window x:Class="AchievementSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:AchievementSync.Desktop.Helpers"
        Title="AchievementSync" Icon="pack://application:,,,/Assets/AchievementSync.ico" Width="1200" Height="800" MinWidth="900" MinHeight="600"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" WindowState="Normal"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AllowsTransparency="False" Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Sidebar items: same base look, each one lights up when its page is the active one. -->
            <Style x:Key="Nav.Games" TargetType="Button" BasedOn="{StaticResource Modern.NavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsGamesVisible}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Modern.AccentSoftBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Modern.AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Nav.Platforms" TargetType="Button" BasedOn="{StaticResource Modern.NavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsPlatformsVisible}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Modern.AccentSoftBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Modern.AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Nav.Activity" TargetType="Button" BasedOn="{StaticResource Modern.NavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActivityVisible}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Modern.AccentSoftBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Modern.AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Nav.Enabler" TargetType="Button" BasedOn="{StaticResource Modern.NavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnablerVisible}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Modern.AccentSoftBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Modern.AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Nav.Settings" TargetType="Button" BasedOn="{StaticResource Modern.NavButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                        <Setter Property="Background" Value="{StaticResource Modern.AccentSoftBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Modern.AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Skeleton cards are only shown while a scan runs and the library is still empty. -->
            <Style x:Key="Skeleton.Panel" TargetType="WrapPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsScanning}" Value="True"/>
                            <Condition Binding="{Binding IsLibraryEmpty}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Completion ribbon: only visible on a game card whose progress is 100%. -->
            <Style x:Key="Card.CompleteBadge" TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Background" Value="#E610302A"/>
                <Setter Property="BorderBrush" Value="{StaticResource Modern.MintBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Margin" Value="10"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Progress}" Value="100">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Availability dot used in the locations list and platform cards. -->
            <Style x:Key="Dot.Availability" TargetType="Ellipse">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Fill" Value="#69758A"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                        <Setter Property="Fill" Value="#72E0BB"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Dot.Configured" TargetType="Border">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Background" Value="#69758A"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                        <Setter Property="Background" Value="#72E0BB"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="{x:Static helpers:SearchBoxBehavior.FocusSearchCommand}"/>
    </Window.InputBindings>

    <Grid Background="{StaticResource Modern.CanvasBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Ambient accent glow (purely decorative, never receives input). -->
        <Ellipse Grid.Column="1" Width="760" Height="760" Fill="{StaticResource Modern.AmbientGlowBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-380,-260,0" IsHitTestVisible="False"/>

        <!-- ============================ SIDEBAR ============================ -->
        <Border Grid.Column="0" Background="{StaticResource Modern.SidebarBrush}" BorderBrush="{StaticResource Modern.StrokeBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,22,16,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,24">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource Modern.AccentGradientBrush}">
                            <TextBlock Text="✦" FontFamily="Segoe UI Symbol" FontSize="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AchievementSync" Style="{StaticResource Modern.Text.Section}" FontSize="15"/>
                            <TextBlock Text="Track · Sync · Back up" Style="{StaticResource Modern.Text.Micro}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Modern.InsetCard}" Padding="10" Margin="0,0,0,22" Visibility="{Binding GitHubAccountVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource Modern.AccentSoftBrush}" BorderBrush="{StaticResource Modern.AccentLineBrush}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="✦" FontFamily="Segoe UI Symbol" Foreground="{StaticResource Modern.AccentGlowBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding GitHubAvatarImage}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="GITHUB" Style="{StaticResource Modern.Text.Overline}"/>
                                <TextBlock Text="{Binding GitHubDisplayName}" FontSize="13" FontWeight="SemiBold" MaxWidth="130" TextTrimming="CharacterEllipsis" ToolTip="{Binding GitHubDisplayName}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="WORKSPACE" Style="{StaticResource Modern.Text.Overline}" Margin="12,0,0,8"/>
                    <Button Style="{StaticResource Nav.Games}" Command="{Binding NavigationCommand}" CommandParameter="Games" Margin="0,0,0,4" ToolTip="Browse every game with achievements found on this PC" AutomationProperties.Name="Game library">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontFamily="Segoe UI Symbol" FontSize="16" Width="28" Style="{StaticResource Modern.Text.OnButton}"/><TextBlock Text="Game library" Style="{StaticResource Modern.Text.OnButton}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Nav.Platforms}" Command="{Binding NavigationCommand}" CommandParameter="Platforms" Margin="0,0,0,4" ToolTip="Configure platform folders and scan each store" AutomationProperties.Name="Platforms">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◎" FontFamily="Segoe UI Symbol" FontSize="16" Width="28" Style="{StaticResource Modern.Text.OnButton}"/><TextBlock Text="Platforms" Style="{StaticResource Modern.Text.OnButton}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Nav.Activity}" Command="{Binding NavigationCommand}" CommandParameter="Activity" Margin="0,0,0,4" ToolTip="Preview and push progress, back up and restore saves" AutomationProperties.Name="Sync activity">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontFamily="Segoe UI Symbol" FontSize="16" Width="28" Style="{StaticResource Modern.Text.OnButton}"/><TextBlock Text="Sync activity" Style="{StaticResource Modern.Text.OnButton}"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource Nav.Enabler}" Command="{Binding OpenEnablerWizardCommand}" Margin="0,0,0,4" AutomationProperties.Name="Achievement Enabler">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚡" FontFamily="Segoe UI Symbol" FontSize="16" Width="28" Style="{StaticResource Modern.Text.OnButton}"/><TextBlock Text="Achievement Enabler" Style="{StaticResource Modern.Text.OnButton}"/></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Rectangle Height="1" Fill="{StaticResource Modern.StrokeBrush}" Margin="4,0,4,12"/>
                    <Button Style="{StaticResource Nav.Settings}" Command="{Binding NavigationCommand}" CommandParameter="Settings" ToolTip="Notifications, startup, scan locations and updates" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontFamily="Segoe UI Symbol" FontSize="16" Width="28" Style="{StaticResource Modern.Text.OnButton}"/><TextBlock Text="Settings" Style="{StaticResource Modern.Text.OnButton}"/></StackPanel>
                    </Button>
                    <TextBlock Text="ACHIEVEMENTSYNC" Style="{StaticResource Modern.Text.Overline}" FontSize="9" Margin="14,16,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ CONTENT ============================ -->
        <Grid Grid.Column="1" Margin="36,26,36,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- Status bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastScanText}" Style="{StaticResource Modern.Text.Micro}" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Style="{StaticResource Modern.Chip}" ToolTip="{Binding ScanStatus}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource Modern.StatusDot}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource Modern.Text.Caption}" Foreground="{StaticResource Modern.TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="380" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">

                <!-- ============================ GAME LIBRARY ============================ -->
                <Grid Visibility="{Binding IsGamesVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="Your game library" Style="{StaticResource Modern.Text.Display}"/>
                        <TextBlock Text="Browse games with at least one unlocked achievement. Filter by progress or sort by name and recent unlock." Style="{StaticResource Modern.Text.Caption}" FontSize="12.5" Margin="0,6,0,0"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Border Style="{StaticResource Modern.Card}" Width="198" Padding="16" Margin="0,0,12,12" ToolTip="Distinct games found across your enabled scan locations">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="GAMES FOUND" Style="{StaticResource Modern.Text.Overline}"/>
                                    <TextBlock Text="{Binding TotalGames}" Style="{StaticResource Modern.Text.Stat}" Margin="0,8,0,0"/>
                                    <TextBlock Text="Across enabled locations" Style="{StaticResource Modern.Text.Micro}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="▦" Style="{StaticResource Modern.Text.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.8"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Modern.Card}" Width="198" Padding="16" Margin="0,0,12,12" ToolTip="Achievement states read from your local profiles (unlocked and locked)">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="KNOWN STATES" Style="{StaticResource Modern.Text.Overline}"/>
                                    <TextBlock Text="{Binding TotalKnownAchievements}" Style="{StaticResource Modern.Text.Stat}" Margin="0,8,0,0"/>
                                    <TextBlock Text="Player states in local profiles" Style="{StaticResource Modern.Text.Micro}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="◈" Style="{StaticResource Modern.Text.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.8"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Modern.Card}" Width="198" Padding="16" Margin="0,0,12,12" ToolTip="Unlocks confirmed in your profiles">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="UNLOCKED" Style="{StaticResource Modern.Text.Overline}"/>
                                    <TextBlock Text="{Binding TotalUnlocked}" Style="{StaticResource Modern.Text.Stat}" Foreground="{StaticResource Modern.MintBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="Confirmed unlocks" Style="{StaticResource Modern.Text.Micro}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="★" Style="{StaticResource Modern.Text.Icon}" Foreground="{StaticResource Modern.MintBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.85"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Modern.Card}" Width="198" Padding="16" Margin="0,0,12,12" ToolTip="Overall completion across games where the total is known">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="COMPLETION" Style="{StaticResource Modern.Text.Overline}"/>
                                    <TextBlock Text="{Binding CompletionText}" Style="{StaticResource Modern.Text.Stat}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding CompletionCoverageText}" Style="{StaticResource Modern.Text.Micro}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Text="◔" Style="{StaticResource Modern.Text.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0.8"/>
                            </Grid>
                        </Border>
                    </WrapPanel>

                    <!-- Search / filter / sort toolbar (Ctrl+F focuses the search field) -->
                    <Grid Grid.Row="2" Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource Modern.SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Tag="Search by game title or AppID   (Ctrl+F)" ToolTip="Search game title or AppID" helpers:SearchBoxBehavior.IsFocusTarget="True"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                            <TextBlock Text="Filter" Style="{StaticResource Modern.Text.Caption}" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding GameFilterOptions}" SelectedItem="{Binding SelectedGameFilter}" Style="{StaticResource Modern.ComboBox}" MinWidth="168" VerticalAlignment="Center" ToolTip="Filter games"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0">
                            <TextBlock Text="Sort" Style="{StaticResource Modern.Text.Caption}" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding GameSortOptions}" SelectedItem="{Binding SelectedGameSort}" Style="{StaticResource Modern.ComboBox}" MinWidth="148" VerticalAlignment="Center" ToolTip="Sort games"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Visibility="{Binding IsGamesVisible, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding GamesView}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource Modern.GameCardButton}" Width="272" Margin="0,0,16,16" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                            <StackPanel>
                                                <Border Height="140" CornerRadius="12" BorderBrush="#2C3650" BorderThickness="1" ClipToBounds="True" Background="{StaticResource Modern.CoverBrush}">
                                                    <Grid>
                                                        <Ellipse Width="150" Height="150" Stroke="#7667F4" StrokeThickness="1" Opacity="0.15" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-35,-50"/>
                                                        <Ellipse Width="102" Height="102" Stroke="#A89FFF" StrokeThickness="1" Opacity="0.18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-12,-24"/>
                                                        <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
                                                        <TextBlock Text="{Binding CoverMark}" Visibility="{Binding FallbackVisibility}" FontFamily="{StaticResource Modern.DisplayFont}" FontSize="36" FontWeight="Light" Foreground="#D9D5FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Border Background="#0D1119" Opacity="0.88" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="APPID" FontSize="9" FontWeight="Bold" Foreground="#AEB8C9"/>
                                                                <TextBlock Text="{Binding AppId}" FontSize="9" FontWeight="Bold" Foreground="#D9D5FF" Margin="5,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource Card.CompleteBadge}" ToolTip="Every achievement unlocked">
                                                            <TextBlock Text="★ COMPLETE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Modern.MintBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Modern.Text.Section}" FontSize="15" Margin="2,14,2,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Modern.Text.Status}" Margin="2,7,2,0"/>
                                                <ProgressBar Style="{StaticResource Modern.ProgressBar}" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding HasMeasurableProgress, Converter={StaticResource BoolToVisibility}}" Margin="2,10,2,0"/>
                                                <TextBlock Text="{Binding AchievementCountText}" Style="{StaticResource Modern.Text.Caption}" FontSize="11" Margin="2,10,2,0"/>
                                                <TextBlock Text="{Binding PlaytimeText}" Visibility="{Binding PlaytimeVisibility, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Modern.Text.Caption}" FontSize="11" Foreground="#B8AEFF" Margin="2,6,2,0"/>
                                                <TextBlock Text="{Binding RecentAchievementText}" Style="{StaticResource Modern.Text.Caption}" FontSize="11" Foreground="{StaticResource Modern.TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RecentAchievementText}" Margin="2,6,2,0"/>
                                                <Rectangle Height="1" Fill="{StaticResource Modern.StrokeBrush}" Margin="2,12,2,9"/>
                                                <TextBlock Text="{Binding SourceCountText}" Style="{StaticResource Modern.Text.Micro}" Margin="2,0,2,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty state + loading skeletons (frontend only: driven by existing view-model flags) -->
                        <StackPanel VerticalAlignment="Top">
                            <Border Style="{StaticResource Modern.Card}" Padding="32,30" HorizontalAlignment="Stretch" Visibility="{Binding IsGameResultsEmpty, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" MaxWidth="560">
                                    <Border Style="{StaticResource Modern.IconBadge}" Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Center">
                                        <TextBlock Text="⌕" Style="{StaticResource Modern.Text.Icon}" FontSize="30"/>
                                    </Border>
                                    <Border Width="180" Height="4" CornerRadius="2" Background="{StaticResource Modern.Surface3Brush}" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                                        <Border Width="70" Height="4" CornerRadius="2" Background="{StaticResource Modern.AccentGradientBrush}" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <TranslateTransform X="-70"/>
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-70" To="180" Duration="0:0:1.3"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{Binding GameResultsEmptyText}" Style="{StaticResource Modern.Text.Section}" FontSize="18" HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding GameResultsEmptyHint}" Style="{StaticResource Modern.Text.Body}" TextAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <WrapPanel Style="{StaticResource Skeleton.Panel}" Margin="0,20,0,0" IsHitTestVisible="False">
                                <Border Style="{StaticResource Modern.Card}" Width="272" Height="338" Padding="14" Margin="0,0,16,16">
                                    <StackPanel>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="140" CornerRadius="12"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="16" Width="170" HorizontalAlignment="Left" Margin="2,18,0,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="11" Width="90" HorizontalAlignment="Left" Margin="2,14,0,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="6" Margin="2,14,2,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="10" Width="150" HorizontalAlignment="Left" Margin="2,16,0,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="10" Width="190" HorizontalAlignment="Left" Margin="2,10,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Modern.Card}" Width="272" Height="338" Padding="14" Margin="0,0,16,16">
                                    <StackPanel>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="140" CornerRadius="12"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="16" Width="140" HorizontalAlignment="Left" Margin="2,18,0,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="11" Width="110" HorizontalAlignment="Left" Margin="2,14,0,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="6" Margin="2,14,2,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="10" Width="170" HorizontalAlignment="Left" Margin="2,16,0,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="10" Width="130" HorizontalAlignment="Left" Margin="2,10,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Modern.Card}" Width="272" Height="338" Padding="14" Margin="0,0,16,16">
                                    <StackPanel>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="140" CornerRadius="12"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="16" Width="190" HorizontalAlignment="Left" Margin="2,18,0,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="11" Width="80" HorizontalAlignment="Left" Margin="2,14,0,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="6" Margin="2,14,2,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="10" Width="160" HorizontalAlignment="Left" Margin="2,16,0,0"/>
                                        <Border Style="{StaticResource Modern.SkeletonBlock}" Height="10" Width="120" HorizontalAlignment="Left" Margin="2,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Modern.Chip}" Background="{StaticResource Modern.WarningSoftBrush}" BorderBrush="#4A3D1F" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4" Visibility="{Binding IssueText, Converter={StaticResource StringToVisibility}}" ToolTip="{Binding IssueText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontFamily="Segoe UI Symbol" FontSize="11" Foreground="{StaticResource Modern.WarningBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding IssueText}" Foreground="{StaticResource Modern.WarningBrush}" FontSize="11" MaxWidth="520" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============================ SETTINGS ============================ -->
                <Grid Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,10,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                                <TextBlock Text="Settings" Style="{StaticResource Modern.Text.Display}"/>
                                <TextBlock Text="Choose which locations AchievementSync scans. Missing folders remain listed as unavailable." Style="{StaticResource Modern.Text.Caption}" FontSize="12.5" Margin="0,6,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource Modern.Card}" Padding="22,18" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="GENERAL" Style="{StaticResource Modern.Text.Overline}" Margin="0,0,0,6"/>
                                        <CheckBox Style="{StaticResource Modern.Switch}" Content="Show achievement unlock notifications" IsChecked="{Binding AchievementNotificationsEnabled, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,10,0,10"/>
                                        <Rectangle Height="1" Fill="{StaticResource Modern.StrokeBrush}"/>
                                        <CheckBox Style="{StaticResource Modern.Switch}" Content="Show game launch &amp; playtime notifications" IsChecked="{Binding PlaytimeNotificationsEnabled, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,10,0,10"/>
                                        <Rectangle Height="1" Fill="{StaticResource Modern.StrokeBrush}"/>
                                        <CheckBox Style="{StaticResource Modern.Switch}" Content="Start AchievementSync with Windows (opens in the tray)" IsChecked="{Binding StartWithWindows, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,10,0,0"/>
                                        <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource Modern.Text.Micro}" Margin="0,5,0,0"/>
                                        <TextBlock Text="If you move AchievementSync.exe, open it once from the new folder so Windows can save the new startup path." Style="{StaticResource Modern.Text.Micro}" Margin="0,3,0,10"/>
                                        <Rectangle Height="1" Fill="{StaticResource Modern.StrokeBrush}"/>
                                        <CheckBox Style="{StaticResource Modern.Switch}" Content="Handheld PC Mode (Compact UI for Steam Deck / ROG Ally)" IsChecked="{Binding CompactModeEnabled, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,10,0,14" ToolTip="Scales down window bounds and toast notifications to fit handheld screens without cutting off."/>
                                        <Border Style="{StaticResource Modern.InsetCard}" Padding="14,12">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="APPLICATION UPDATES" Style="{StaticResource Modern.Text.Overline}"/>
                                                <Grid Grid.Row="1" Margin="0,9,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Modern.Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Check now" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding CanCheckForUpdates}" Style="{StaticResource Modern.SecondaryButton}" Padding="12,7" Margin="0,0,6,0"/>
                                                        <Button Content="{Binding AvailableUpdateVersion}" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Modern.PrimaryButton}" Padding="12,7"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Test notification" Command="{Binding TestNotificationCommand}" Style="{StaticResource Modern.SecondaryButton}" VerticalAlignment="Top" Padding="14,9" Margin="20,0,0,0" ToolTip="Shows a local preview only; no achievement data is changed."/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource Modern.Card}" Padding="22,18" Margin="0,0,0,26">
                                <StackPanel>
                                    <TextBlock Text="ACHIEVEMENT NOTIFICATION POSITION &amp; SOUND" Style="{StaticResource Modern.Text.Overline}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Position, offsets, sound, and display selection apply to unlock toasts. Game session banners center on the active game screen." Style="{StaticResource Modern.Text.Caption}" Margin="0,0,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Position" Style="{StaticResource Modern.Text.Body}" VerticalAlignment="Center" Width="64"/>
                                                <ComboBox ItemsSource="{Binding NotificationPositionOptions}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding NotificationPosition}" Style="{StaticResource Modern.ComboBox}" Width="190" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <TextBlock Text="Offset X" Style="{StaticResource Modern.Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" Width="56"/>
                                                <TextBox Text="{Binding NotificationOffsetX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Modern.TextBox}" Width="76" VerticalAlignment="Center"/>
                                                <TextBlock Text="Offset Y" Style="{StaticResource Modern.Text.Caption}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                                                <TextBox Text="{Binding NotificationOffsetY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Modern.TextBox}" Width="76" VerticalAlignment="Center"/>
                                                <TextBlock Text="px" Style="{StaticResource Modern.Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <Rectangle Height="1" Fill="{StaticResource Modern.StrokeBrush}" Margin="0,16,0,0"/>
                                            <CheckBox Style="{StaticResource Modern.Switch}" Content="Play a sound when an achievement is unlocked" IsChecked="{Binding NotificationSoundEnabled, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,12,0,12"/>
                                            <Rectangle Height="1" Fill="{StaticResource Modern.StrokeBrush}"/>
                                            <CheckBox Style="{StaticResource Modern.Switch}" Content="Auto-detect which screen you are playing on" IsChecked="{Binding AutoDetectActiveGameScreen, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Margin="0,12,0,14" ToolTip="Automatically pops up the unlock toast on the exact monitor running your active game."/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Sound" Style="{StaticResource Modern.Text.Body}" VerticalAlignment="Center" Width="64"/>
                                                <ComboBox ItemsSource="{Binding NotificationSoundOptions}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding NotificationSound}" Style="{StaticResource Modern.ComboBox}" Width="190" VerticalAlignment="Center"/>
                                                <Button Content="Choose…" Command="{Binding BrowseNotificationSoundCommand}" IsEnabled="{Binding CanBrowseNotificationSound}" Visibility="{Binding CanBrowseNotificationSound, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Modern.SecondaryButton}" Padding="12,8" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Pick any .wav file from your PC as the achievement sound"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding NotificationSoundCustomPath}" Style="{StaticResource Modern.Text.Micro}" Margin="64,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding NotificationSoundCustomPath}" Visibility="{Binding CanBrowseNotificationSound, Converter={StaticResource BoolToVisibility}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <TextBlock Text="Volume" Style="{StaticResource Modern.Text.Body}" VerticalAlignment="Center" Width="64"/>
                                                <Slider Minimum="0" Maximum="100" Value="{Binding NotificationSoundVolume}" Width="190" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding NotificationSoundVolume, StringFormat={}{0}%}" Style="{StaticResource Modern.Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" Width="40"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="24,0,0,0">
                                            <Button Content="Preview notification" Command="{Binding TestNotificationCommand}" Style="{StaticResource Modern.SecondaryButton}" Padding="14,9" ToolTip="Shows a local preview at the selected position; no achievement data is changed."/>
                                            <Button Content="Preview sound" Command="{Binding PreviewNotificationSoundCommand}" Style="{StaticResource Modern.SecondaryButton}" Padding="14,9" Margin="0,8,0,0" ToolTip="Plays the achievement chime once; nothing is unlocked."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="3" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Achievement locations" Style="{StaticResource Modern.Text.Section}" FontSize="18"/>
                                    <TextBlock Text="Recursive scanning is read-only and does not modify source files." Style="{StaticResource Modern.Text.Caption}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Modern.SecondaryButton}" Click="AddFolder_Click" VerticalAlignment="Center" ToolTip="Add a custom folder to scan">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="15" Margin="0,-2,7,0"/><TextBlock Text="Add folder"/></StackPanel>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Locations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Modern.Card}" Padding="16,14" CornerRadius="14" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Modern.CheckBox}" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="1,0,16,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Modern.Text.Micro}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                        <TextBlock Text="{Binding DiscoveryText}" Style="{StaticResource Modern.Text.Micro}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <Ellipse Style="{StaticResource Dot.Availability}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource Modern.Text.Caption}" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                                        <Button Content="Remove" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}" Command="{Binding DataContext.RemoveLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource Modern.GhostButton}" Padding="10,6" FontSize="11" Margin="12,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- ============================ SYNC ACTIVITY ============================ -->
                <Grid Visibility="{Binding IsActivityVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid MinHeight="800" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Margin="0,0,8,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sync activity" Style="{StaticResource Modern.Text.Display}"/>
                                    <TextBlock Text="Preview and push numeric Steam AppID progress, or manage confirmed save backups and restores." Style="{StaticResource Modern.Text.Caption}" FontSize="12.5" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- GitHub connection -->
                            <Border Grid.Row="1" Style="{StaticResource Modern.Card}" Padding="20,16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                    <StackPanel Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,0,18,0">
                                        <TextBlock Text="GITHUB ACCOUNT" Style="{StaticResource Modern.Text.Overline}"/>
                                        <TextBlock Text="{Binding GitHubAccountText}" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GitHubStatus}" Style="{StaticResource Modern.Text.Caption}" Foreground="{StaticResource Modern.TextSecondaryBrush}" Margin="0,5,0,0" MaxWidth="215"/>
                                    </StackPanel>

                                    <Grid Grid.Column="1" Grid.Row="0" VerticalAlignment="Top" Margin="0,0,18,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0"><TextBlock Text="OWNER" Style="{StaticResource Modern.Text.Overline}" Margin="2,0,0,5"/><TextBox Text="{Binding GitHubOwner, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Modern.TextBox}" ToolTip="Your GitHub account name"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="REPOSITORY" Style="{StaticResource Modern.Text.Overline}" Margin="2,0,0,5"/><TextBox Text="{Binding GitHubRepository, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Modern.TextBox}" ToolTip="Your achievement-viewer fork"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="BRANCH" Style="{StaticResource Modern.Text.Overline}" Margin="2,0,0,5"/><TextBox Text="{Binding GitHubBranch, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Modern.TextBox}" ToolTip="For example: user"/></StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,4,18,0">
                                        <CheckBox Style="{StaticResource Modern.Switch}" Content="Automatically push newly unlocked achievements to GitHub (enabled explicitly)" IsChecked="{Binding AutoSyncAfterUnlock, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" Foreground="{StaticResource Modern.TextSecondaryBrush}" ToolTip="Pushes only the newly changed AppID file to your configured repository whenever a genuinely new unlock is detected. Disabled by default."/>
                                        <TextBlock Text="{Binding AutoSyncStatus}" Style="{StaticResource Modern.Text.Micro}" Margin="0,6,0,0" Visibility="{Binding AutoSyncStatusVisibility}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Grid.RowSpan="2" Width="206" VerticalAlignment="Top">
                                        <TextBlock Text="PERSONAL ACCESS TOKEN" Style="{StaticResource Modern.Text.Overline}" Margin="2,0,0,5"/>
                                        <PasswordBox x:Name="GitHubTokenBox" Style="{StaticResource Modern.SecretBox}" ToolTip="Classic GitHub token with public_repo scope; checked once and stored in Windows Credential Manager"/>
                                        <Button Content="Connect with token" Click="ConnectGitHubWithToken_Click" Style="{StaticResource Modern.SecondaryButton}" Padding="10,8" Margin="0,8,0,0"/>
                                        <Button Content="Sign in with OAuth" Command="{Binding SignInToGitHubCommand}" IsEnabled="{Binding CanStartGitHubSignIn}" Style="{StaticResource Modern.PrimaryButton}" Padding="10,8" Margin="0,6,0,0" ToolTip="Sign in with the configured GitHub OAuth application."/>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Content="Disconnect" Command="{Binding DisconnectGitHubCommand}" IsEnabled="{Binding IsGitHubSignedIn}" Style="{StaticResource Modern.SecondaryButton}" Padding="8,8" Margin="0,0,3,0" ToolTip="Remove the saved GitHub credential from Windows Credential Manager."/>
                                            <Button Grid.Column="1" Content="Sync all achievement data" Command="{Binding SyncAllMetadataCommand}" IsEnabled="{Binding CanSyncAll}" Style="{StaticResource Modern.SecondaryButton}" Padding="8,8" Margin="3,0,0,0" ToolTip="Collect configured platform sources, review the target, and confirm before uploading AppID achievement JSON or platform marker files."/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Backup & restore -->
                            <Border Grid.Row="2" Style="{StaticResource Modern.Card}" Padding="20,16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="BACKUP &amp; RESTORE" Style="{StaticResource Modern.Text.Overline}"/>
                                        <TextBlock Text="{Binding BackupStatus}" Style="{StaticResource Modern.Text.Status}" FontSize="11" Margin="0,6,0,6"/>
                                        <CheckBox Style="{StaticResource Modern.Switch}" Content="Auto-back up new and changed saves to GitHub after playtime stops" IsChecked="{Binding AutoBackupSavesAfterPlaytime, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" Margin="0,4,0,8" ToolTip="After the tracked game session ends, waits for save files to settle and uploads new or changed files to the connected public GitHub repository. Existing remote files at the same paths are updated. Disabled by default."/>
                                        <ProgressBar Style="{StaticResource Modern.ProgressBar}" Minimum="0" Maximum="100" Value="{Binding BackupProgressPercent, Mode=OneWay}" Visibility="{Binding IsBackupRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding BackupStage}" Style="{StaticResource Modern.Text.Micro}" Margin="0,0,0,6" Visibility="{Binding IsBackupRunning, Converter={StaticResource BoolToVisibility}}"/>
                                        <ListBox ItemsSource="{Binding BackupResults}" Style="{StaticResource Modern.ResultList}" Tag="No backup activity yet. Back up saves to see results here." MaxHeight="96" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Modern.InsetCard}" CornerRadius="9" Padding="9,7"><TextBlock Text="{Binding}" Style="{StaticResource Modern.Text.Micro}" Foreground="{StaticResource Modern.MutedBrush}"/></Border></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <Button Content="Backup saves" Command="{Binding BackupSavesCommand}" IsEnabled="{Binding CanBackup}" Style="{StaticResource Modern.PrimaryButton}" Padding="14,9" Margin="0,0,0,8" ToolTip="Connect GitHub first. Discovers game save files in known locations, then shows the files for confirmation before upload."/>
                                        <Button Content="Restore from GitHub" Command="{Binding RestoreSavesCommand}" IsEnabled="{Binding CanRestore}" Style="{StaticResource Modern.SecondaryButton}" Padding="14,9" ToolTip="Connect GitHub first. Scans the selected branch even on a new PC with an empty library, then restores missing saves to their recorded paths and achievements to the local library cache. Existing files are kept."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RESTORE" Style="{StaticResource Modern.Text.Overline}"/>
                                        <TextBlock Text="{Binding RestoreStatus}" Style="{StaticResource Modern.Text.Status}" FontSize="11" Margin="0,6,0,6"/>
                                        <ListBox ItemsSource="{Binding RestoreResults}" Style="{StaticResource Modern.ResultList}" Tag="No restore activity yet. Restore from GitHub to see results here." MaxHeight="96" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Modern.InsetCard}" CornerRadius="9" Padding="9,7"><TextBlock Text="{Binding}" Style="{StaticResource Modern.Text.Micro}" Foreground="{StaticResource Modern.MutedBrush}"/></Border></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Preview / push -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Modern.Card}" Padding="16" Margin="0,0,14,0">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="FILES IN PREVIEW" Style="{StaticResource Modern.Text.Overline}" Margin="2,0,0,10"/>
                                        <ListBox Grid.Row="1" ItemsSource="{Binding ExportFiles}" SelectedItem="{Binding SelectedExport, Mode=TwoWay}" Style="{StaticResource Modern.ResultList}" Tag="Nothing to review yet. Press Build preview to see exactly which files would change." ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Modern.InsetCard}" CornerRadius="10" Padding="12,10">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding RelativePath}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Modern.Text.Micro}" Foreground="{StaticResource Modern.MutedBrush}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Grid.Row="2" Text="{Binding BulkSyncStatus}" Style="{StaticResource Modern.Text.Status}" FontSize="11" Margin="2,10,0,6"/>
                                        <ListBox Grid.Row="3" ItemsSource="{Binding BulkSyncResults}" Style="{StaticResource Modern.ResultList}" Tag="Bulk sync results will appear here." MaxHeight="130" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Modern.InsetCard}" CornerRadius="9" Padding="9,7"><TextBlock Text="{Binding}" Style="{StaticResource Modern.Text.Micro}" Foreground="{StaticResource Modern.MutedBrush}"/></Border></DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource Modern.Card}" Padding="16,12" CornerRadius="14" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource Modern.Text.Status}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Build preview" Command="{Binding BuildGitHubPreviewCommand}" Style="{StaticResource Modern.SecondaryButton}" Padding="14,9" Margin="0,0,8,0" ToolTip="Fetch the selected repository and prepare the exact files for review."/>
                                                <Button Content="Push reviewed changes" Command="{Binding PushGitHubPreviewCommand}" Style="{StaticResource Modern.PrimaryButton}" Padding="14,9" ToolTip="Uploads only the changes shown in the preview after confirmation."/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Style="{StaticResource Modern.InsetCard}" Padding="14" CornerRadius="14">
                                        <Grid>
                                            <TextBox Text="{Binding SelectedExport.FormattedJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Foreground="#D6DFEB" FontFamily="Consolas" FontSize="12" ToolTip="Exact JSON for the selected AppID file (pretty-printed)"/>
                                            <TextBlock Text="{Binding EmptyExportMessage}" Style="{StaticResource Modern.Text.Caption}" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" IsHitTestVisible="False" Visibility="{Binding EmptyExportMessageVisibility}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid Visibility="{Binding IsEnablerVisible, Converter={StaticResource BoolToVisibility}}">
                    <ContentControl x:Name="AchievementEnablerHost" />
                </Grid>

                <!-- ============================ PLATFORMS ============================ -->
                <Grid Visibility="{Binding IsPlatformsVisible, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,0,10,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                                <TextBlock Text="Platforms" Style="{StaticResource Modern.Text.Display}"/>
                                <TextBlock Text="AchievementSync monitors configured local sources and refreshes data when files change. Review matched Steam AppIDs before export; GitHub sync unions local progress and adds source markers for non-Steam platforms." Style="{StaticResource Modern.Text.Caption}" FontSize="12.5" Margin="0,6,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource Modern.Card}" Padding="16,13" CornerRadius="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Modern.MintBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding PlatformScanStatus}" Style="{StaticResource Modern.Text.Status}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Review Steam Mappings" Command="{Binding OpenMappingReviewCommand}" Style="{StaticResource Modern.SecondaryButton}" Padding="14,7" FontSize="12" ToolTip="Review resolved Steam AppIDs, confidence ratings, and manual overrides"/>
                                </Grid>
                            </Border>

                            <Expander Grid.Row="2" Header="Configure source folders and API access" IsExpanded="True" Style="{StaticResource Modern.Expander}" Margin="0,0,0,18">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding PlatformSourceEntries}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="480" Margin="0,0,14,10">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Modern.Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Modern.TextBox}" ToolTip="{Binding Description}"/>
                                                    <Button Grid.Column="2" Content="Browse…" Command="{Binding BrowseCommand}" Style="{StaticResource Modern.SecondaryButton}" Padding="12,8" Margin="8,0,0,0"/>
                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Description}" Style="{StaticResource Modern.Text.Micro}" TextWrapping="Wrap" Margin="112,3,4,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Style="{StaticResource Modern.InsetCard}" Padding="14" Margin="0,6,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="RetroAchievements public progress" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBox Text="{Binding RetroAchievementsUser, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Modern.TextBox}" Margin="0,8,0,0" ToolTip="RetroAchievements username"/>
                                                    <PasswordBox x:Name="RetroAchievementsApiKeyBox" Style="{StaticResource Modern.SecretBox}" Margin="0,8,0,0" ToolTip="API key saved only in Windows Credential Manager"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0,12,0">
                                                    <TextBlock Text="Xbox PC account" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBox Text="{Binding XboxClientId, UpdateSourceTrigger=LostFocus}" Style="{StaticResource Modern.TextBox}" Margin="0,8,0,0" ToolTip="Your Microsoft Entra public-client Application ID. The app uses device-code sign-in and never supplies a borrowed client ID."/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <Button Content="Connect Xbox PC" Click="ConnectXboxPlatform_Click" Style="{StaticResource Modern.PrimaryButton}" Padding="12,8" Margin="0,0,0,6" ToolTip="Sign in with the Xbox account used by the Xbox app through Microsoft's device-code flow."/>
                                                    <Button Content="Save RA API key" Click="SavePlatformCredentials_Click" Style="{StaticResource Modern.SecondaryButton}" Padding="12,8" Margin="0,0,0,6" ToolTip="Saves the RetroAchievements API key to Windows Credential Manager. Client IDs save automatically."/>
                                                    <Button Content="Clear saved tokens" Click="ClearPlatformCredentials_Click" Style="{StaticResource Modern.SecondaryButton}" Padding="12,8"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="2,10,0,0">
                                                <TextBlock Text="{Binding PlatformCredentialStatus}" Style="{StaticResource Modern.Text.Micro}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <CheckBox Style="{StaticResource Modern.Switch}" Content="Enable LumaPlay registry monitoring" IsChecked="{Binding LumaPlayWatcherEnabled, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" ToolTip="On Windows, watch HKCU\SOFTWARE\LumaPlay for achievement changes and rescan Ubisoft progress. This is optional and off by default."/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <Grid Grid.Row="3" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="PLATFORM STATUS" Style="{StaticResource Modern.Text.Overline}"/></StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding PlatformStatuses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Modern.Card}" Padding="16,14" CornerRadius="14" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource Modern.IconBadge}" Width="42" Height="42" Margin="0,0,14,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Platform, Converter={StaticResource PlatformIconConverter}}" Style="{StaticResource Modern.Text.Icon}" FontSize="20"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Modern.Text.Section}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Modern.Text.Caption}" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Hint}" Style="{StaticResource Modern.Text.Micro}" Margin="0,4,0,0" Visibility="{Binding Hint, Converter={StaticResource StringToVisibility}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" Orientation="Horizontal">
                                                        <Border Style="{StaticResource Modern.Chip}" Padding="10,4" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding GamesFound, StringFormat='Games: {0}'}" FontSize="11" Foreground="{StaticResource Modern.MintBrush}" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Dot.Configured}" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding IsConfigured, Converter={StaticResource BoolToConfiguredText}}" Style="{StaticResource Modern.Text.Caption}" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                        <Button Content="Scan platform" Command="{Binding DataContext.ScanPlatformCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Platform}" IsEnabled="{Binding DataContext.CanScanPlatform, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Style="{StaticResource Modern.SecondaryButton}" Padding="12,7" FontSize="12" ToolTip="Scan this platform’s configured sources"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
