<Window x:Class="AchievementSync.Desktop.PlaytimeNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1000" Height="563" MinWidth="0" MinHeight="0" MaxWidth="1000" MaxHeight="563" Opacity="0"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False" WindowStartupLocation="Manual">
    <Border x:Name="RootBorder" CornerRadius="18" Background="#F20A0E15" BorderBrush="#3A4356" BorderThickness="1.5"
            Padding="0" Margin="10" MouseLeftButtonUp="OnMouseLeftButtonUp" Cursor="Hand" SnapsToDevicePixels="True"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" BlurRadius="30" Direction="270" ShadowDepth="5" Opacity="0.62" Color="#000000"/>
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#10000000" Offset="0.42"/>
                        <GradientStop Color="#D9000000" Offset="0.78"/>
                        <GradientStop Color="#F5000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border x:Name="AccentGlow" VerticalAlignment="Bottom" Height="150" Opacity="0.18" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#80FF9D3A" Offset="0"/>
                        <GradientStop Color="#00FF9D3A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel VerticalAlignment="Bottom" Margin="56,0,56,36">
                <Grid Height="24" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Height="1.5" Fill="#F3AA4B" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock x:Name="BadgeText" Grid.Column="1" Text="PLAYTIME STARTED" Foreground="#FFC15A"
                               FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Rectangle Grid.Column="2" Height="1.5" Fill="#F3AA4B" VerticalAlignment="Center" Margin="18,0,0,0"/>
                </Grid>

                <TextBlock x:Name="GameTitleText" Text="Game Title" Foreground="#FFFFFF" FontSize="48"
                           FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" MaxHeight="72"/>
                <TextBlock x:Name="MessageText" Text="Playtime tracking started" Foreground="#E6EAF0"
                           FontSize="16" TextAlignment="Center" Margin="0,8,0,0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock Text="ACHIEVEMENTSYNC" Foreground="#A5A8AF" FontSize="9"
                           FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
