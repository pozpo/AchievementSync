<Window x:Class="AchievementSync.Desktop.Views.MappingReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AchievementSync.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Review Steam AppID Mappings" Width="820" Height="580" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Modern.CanvasBrush}"
        d:DataContext="{d:DesignInstance vm:MappingReviewViewModel}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ModernTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Review Steam AppID Mappings" Style="{StaticResource Modern.Text.Display}" FontSize="20"/>
            <TextBlock Text="Review how non-Steam platform games resolve to Steam AppIDs. Override with a manual numeric AppID or blacklist games you don't wish to track." Style="{StaticResource Modern.Text.Caption}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar / Search -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource Modern.SearchBox}" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Tag="Search by title, platform, source ID, or AppID" ToolTip="Filter mapping list"/>
            <TextBlock Grid.Column="1" Text="{Binding TotalCount, StringFormat='Total: {0} game(s)'}" Style="{StaticResource Modern.Text.Micro}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </Grid>

        <!-- Items list -->
        <Border Grid.Row="2" Style="{StaticResource Modern.Card}" Padding="12" CornerRadius="12" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ItemsView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Modern.InsetCard}" Padding="12,10" Margin="0,0,0,8" CornerRadius="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Platform Icon / Badge -->
                                    <Border Grid.Column="0" Style="{StaticResource Modern.IconBadge}" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Platform, Converter={StaticResource PlatformIconConverter}}" Style="{StaticResource Modern.Text.Icon}" FontSize="18"/>
                                    </Border>

                                    <!-- Game Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding SourceTitle}" Style="{StaticResource Modern.Text.Section}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                            <Border Style="{StaticResource Modern.Chip}" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Platform}" Style="{StaticResource Modern.Text.Micro}" Foreground="{StaticResource Modern.MintBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding SourceGameId, StringFormat='Source ID: {0}'}" Style="{StaticResource Modern.Text.Micro}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding ConfidenceDisplay, StringFormat='Confidence: {0}'}" Style="{StaticResource Modern.Text.Micro}" Foreground="{StaticResource Modern.AccentGlowBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding NormalizedAchievementCount, StringFormat='Achievements: {0}'}" Style="{StaticResource Modern.Text.Micro}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding MatchReason}" Style="{StaticResource Modern.Text.Micro}" Foreground="{StaticResource Modern.MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Manual Override Input -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Steam AppID Override" Style="{StaticResource Modern.Text.Overline}" FontSize="9"/>
                                        <TextBox Style="{StaticResource Modern.TextBox}" Text="{Binding OverrideAppId, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" MinHeight="28" Padding="6,4" ToolTip="Leave blank to use auto-resolved AppID"/>
                                    </StackPanel>

                                    <!-- Blacklist Checkbox -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource Modern.CheckBox}" Content="Blacklist" IsChecked="{Binding IsBlacklisted, UpdateSourceTrigger=PropertyChanged}" ToolTip="Exclude this game from Steam achievement exports"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer / Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource Modern.SecondaryButton}" Padding="14,8" Margin="0,0,10,0"/>
            <Button Content="Save Mappings" IsDefault="True" Click="SaveMappings_Click" Style="{StaticResource Modern.PrimaryButton}" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
