<Page x:Class="AchievementSync.Desktop.Views.SteamAchievementWizard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:AchievementSync.Desktop.ViewModels"
      mc:Ignorable="d"
      d:DesignWidth="900" d:DesignHeight="700">
    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="StepNumber">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7667F4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SubtitleText">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#AAB5C5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style TargetType="TextBox" x:Key="WizardInput" BasedOn="{StaticResource SearchBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox" x:Key="WizardPassword" BasedOn="{StaticResource SearchBox}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Background="#0B0E14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,20,24,24" Background="#111721" BorderBrush="#1C2430" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Grid.Column="0" Text="{Binding PageTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource SubtitleText}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource StepNumber}" Text="{Binding StepProgressText}"/>
            </Grid>
        </Border>

        <!-- Content -->
        <Border Grid.Row="1" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="700" Margin="0,0,0,0">

                    <!-- Step 1: Welcome -->
                    <StackPanel Visibility="{Binding IsStepWelcome, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Welcome to Achievement Enabler" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="Set up permanent achievement support for your Steam games. This wizard runs generate_emu_config.exe locally on your PC — no external apps are downloaded or modified." FontSize="12" Foreground="#AAB5C5" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Border Width="4" Height="4" Background="#69D9B3" CornerRadius="2" Margin="0,4,8,0"/>
                            <TextBlock Text="Sign in once — credentials stay in Windows Credential Manager" FontSize="11" Foreground="#AAB5C5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="4" Height="4" Background="#69D9B3" CornerRadius="2" Margin="0,4,8,0"/>
                            <TextBlock Text="Generate achievement JSON — runs your local generate_emu_config.exe" FontSize="11" Foreground="#AAB5C5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="4" Height="4" Background="#69D9B3" CornerRadius="2" Margin="0,4,8,0"/>
                            <TextBlock Text="Review before applying — you approve every file before it is written" FontSize="11" Foreground="#AAB5C5"/>
                        </StackPanel>
                        <Button Content="Get started" Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButton}" Padding="14,9" Margin="0,20,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Step 2: Sign in -->
                    <StackPanel Visibility="{Binding IsStepSignIn, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Sign in to Steam" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="Enter your Steam account login. Username and password are stored in Windows Credential Manager and are never sent anywhere except to the local generate_emu_config.exe." FontSize="12" Foreground="#AAB5C5" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Username" FontSize="10" FontWeight="Bold" Foreground="#667386" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SteamUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WizardInput}" ToolTip="Your Steam account name"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Password" FontSize="10" FontWeight="Bold" Foreground="#667386" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="SteamPasswordBox" Style="{StaticResource WizardPassword}" PasswordChanged="SteamPasswordBox_PasswordChanged" ToolTip="Your Steam account password"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Save credentials" Command="{Binding SignInCommand}" IsEnabled="{Binding CanSignIn}" Style="{StaticResource PrimaryButton}" Padding="14,9" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding SignInStatus}" FontSize="10" Foreground="#AAB5C5" Margin="12,6,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="450"/>
                        </StackPanel>

                        <Border Background="#151D27" BorderBrush="#293345" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="What happens next" FontSize="11" FontWeight="Bold" Foreground="#69D9B3" Margin="0,0,0,8"/>
                                <TextBlock Text="• Credentials are saved only in Windows Credential Manager on this PC." TextWrapping="Wrap" FontSize="10" Foreground="#AAB5C5" Margin="0,0,0,4"/>
                                <TextBlock Text="• They are passed only to your local generate_emu_config.exe when refreshing schema." TextWrapping="Wrap" FontSize="10" Foreground="#AAB5C5" Margin="0,0,0,4"/>
                                <TextBlock Text="• Nothing is uploaded to the internet by AchievementSync." TextWrapping="Wrap" FontSize="10" Foreground="#AAB5C5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Step 3: Select game -->
                    <StackPanel Visibility="{Binding IsStepSelectGame, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Select your game" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="Pick the game install folder, or just type its Steam AppID." FontSize="12" Foreground="#AAB5C5" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Game install folder" FontSize="10" FontWeight="Bold" Foreground="#667386" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding GameFolder, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WizardInput}" ToolTip="Folder containing steam_appid.txt and the game executable"/>
                                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseGameCommand}" Style="{StaticResource QuietButton}" Padding="12,8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Steam AppID (numeric)" FontSize="10" FontWeight="Bold" Foreground="#667386" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AppId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WizardInput}" ToolTip="Numeric Steam AppID, e.g. 4115450"/>
                        </StackPanel>

                        <Button Content="Detect game &amp; AppID" Command="{Binding DetectCommand}" IsEnabled="{Binding CanDetect}" Style="{StaticResource PrimaryButton}" Padding="14,9" Margin="0,16,0,0" HorizontalAlignment="Left"/>

                        <TextBlock Text="{Binding DetectionStatus}" FontSize="10" Foreground="#AAB5C5" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="600"/>
                        <TextBlock Text="{Binding GameSelectionStatus}" FontSize="10" Foreground="#AAB5C5" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="600"/>

                        <Border Background="#151D27" BorderBrush="#293345" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Detected" FontSize="11" FontWeight="Bold" Foreground="#69D9B3" Margin="0,0,0,8"/>
                                <TextBlock Text="Executable:" FontSize="10" Foreground="#667386" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding DetectedExecutable}" FontSize="10" Foreground="#D9D5FF" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="AppID:" FontSize="10" Foreground="#667386" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding DetectedAppId}" FontSize="10" Foreground="#D9D5FF" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding DetectionEvidence}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="9" Foreground="#77849A" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Step 4: Configure -->
                    <StackPanel Visibility="{Binding IsStepConfigure, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Configure generator" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="Point at the local generate_emu_config.exe runtime. Credentials are already saved — they will be passed to the generator." FontSize="12" Foreground="#AAB5C5" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="generate_emu_config.exe folder" FontSize="10" FontWeight="Bold" Foreground="#667386" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding GeneratorRoot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WizardInput}" IsReadOnly="True" ToolTip="Folder containing generate_emu_config.exe"/>
                                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseGeneratorCommand}" Style="{StaticResource QuietButton}" Padding="12,8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="AppID" FontSize="10" FontWeight="Bold" Foreground="#667386" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AppId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WizardInput}" IsReadOnly="True" ToolTip="Numeric Steam AppID detected or entered earlier"/>
                        </StackPanel>

                        <Border Background="#151D27" BorderBrush="#293345" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Generator status" FontSize="11" FontWeight="Bold" Foreground="#69D9B3" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding GeneratorRoot}" FontSize="10" Foreground="#D9D5FF" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding GeneratorStatusMessage}" FontSize="10" Foreground="{Binding GeneratorConfigured, Converter={StaticResource BoolToGreenBrushConverter}}" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Generate plan" Command="{Binding GeneratePlanCommand}" IsEnabled="{Binding CanGeneratePlan}" Style="{StaticResource PrimaryButton}" Padding="14,9" Margin="0,20,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- Step 5: Generate plan -->
                    <StackPanel Visibility="{Binding IsStepGeneratePlan, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Generate plan" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="Running generate_emu_config.exe locally for AppID {Binding AppId}." FontSize="12" Foreground="#AAB5C5" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="{Binding GenerationStatus}" FontSize="12" Foreground="#D9D5FF" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding GenerationProgress}" Height="6" Margin="0,8,0,0" Background="#2A3240" Foreground="#69D9B3" BorderThickness="0"/>
                        </StackPanel>

                        <Border Background="#151D27" BorderBrush="#293345" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="What happens" FontSize="11" FontWeight="Bold" Foreground="#69D9B3" Margin="0,0,0,8"/>
                                <TextBlock Text="• generate_emu_config.exe runs with your locally saved Steam credentials." TextWrapping="Wrap" FontSize="10" Foreground="#AAB5C5" Margin="0,0,0,4"/>
                                <TextBlock Text="• It writes achievement JSON under generate_emu_config\\output\\&lt;AppID&gt;\\steam_settings." TextWrapping="Wrap" FontSize="10" Foreground="#AAB5C5" Margin="0,0,0,4"/>
                                <TextBlock Text="• Nothing is uploaded — this step only creates local files for review." TextWrapping="Wrap" FontSize="10" Foreground="#AAB5C5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Step 6: Review plan -->
                    <StackPanel Visibility="{Binding IsStepReviewPlan, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Review plan" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding PlanSummary}" FontSize="12" Foreground="#AAB5C5" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <ListBox ItemsSource="{Binding PlanItems}" MaxHeight="320" Background="#151D27" BorderBrush="#293345" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10151D" BorderBrush="#293345" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Description}" FontSize="11" FontWeight="SemiBold" Foreground="#D9D5FF"/>
                                                <TextBlock Text="{Binding Destination}" FontSize="9" Foreground="#77849A" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Source, StringFormat='from {0}'}" FontSize="9" Foreground="#AAB5C5" Margin="0,2,0,0" Visibility="{Binding Source, Converter={StaticResource StringToVisibility}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="9" FontWeight="Bold" Foreground="#7667F4" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource QuietButton}" Padding="12,8" HorizontalAlignment="Left"/>
                            <Button Content="Apply plan" Command="{Binding ApplyPlanCommand}" IsEnabled="{Binding CanApplyPlan}" Style="{StaticResource PrimaryButton}" Padding="14,9" Margin="8,0,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Step 7: Applied -->
                    <StackPanel Visibility="{Binding IsStepApplied, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="✓ Plan applied" FontSize="18" FontWeight="SemiBold" Foreground="#69D9B3" Margin="0,0,0,12"/>
                        <TextBlock Text="Your game folder now contains the emulator configuration and generated achievement files." FontSize="12" Foreground="#AAB5C5" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Border Background="#151D27" BorderBrush="#293345" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding ApplyStatus}" FontSize="12" Foreground="#D9D5FF" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button Content="Close" Command="{Binding CancelCommand}" Style="{StaticResource QuietButton}" Padding="14,9" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
