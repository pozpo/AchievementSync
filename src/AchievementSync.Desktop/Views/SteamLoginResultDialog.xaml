<Window x:Class="AchievementSync.Desktop.Views.SteamLoginResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam account" Width="500" Height="270" MinWidth="440" MinHeight="250"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1" CornerRadius="14" Margin="16" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="StatusBadge" Width="38" Height="38" CornerRadius="19"
                        Background="#1E3A34" Margin="0,0,12,0">
                    <TextBlock x:Name="StatusIcon" Text="✓" FontSize="21" FontWeight="Bold"
                               Foreground="{StaticResource MintBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="DialogTitle" Text="Steam login saved" FontSize="18"
                           FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="DialogMessage" Grid.Row="1" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" Margin="50,14,0,18"
                       VerticalAlignment="Top"/>
            <Button Grid.Row="2" Content="OK" Style="{StaticResource PrimaryButton}"
                    Width="100" Height="36" HorizontalAlignment="Right" IsDefault="True"
                    IsCancel="True" Click="Ok_Click"/>
        </Grid>
    </Border>
</Window>
